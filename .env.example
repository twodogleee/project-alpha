# 从工程根目录启动时，后端读取根目录 .env；系统环境变量优先。
# 复制本文件为 .env 并填写本机密码；.env 已忽略，不进入版本控制或 JAR。
ALPHA_SERVER_ADDRESS=127.0.0.1
ALPHA_SERVER_PORT=18080
# 日志同时输出控制台与滚动文件；相对路径以启动工作目录为基准。
ALPHA_LOG_DIR=./logs
# 平台、模型、API Key 与当前启用选择均在系统设置中维护，运行时只读取数据库。
# 可选：稳定的随机 32 字节主密钥的 Base64，只在后端读取。
# 留空时本地首次加密自动创建 0600 私有文件；备份数据库需保管同一主密钥。
ALPHA_MODEL_CONFIG_ENCRYPTION_KEY=
ALPHA_MODEL_CONFIG_KEY_FILE=./data/model-config.key
# 原型生成需要已启用真实模型以及完成 prototype:prepare 的本机 Vite / Chromium 工具链。
# 可选，指定已有 Chromium 的可执行文件绝对路径；默认自动检测本机安装。
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
ALPHA_PROTOTYPE_GENERATION_ENABLED=true
ALPHA_PROTOTYPE_ARTIFACT_ROOT=./data/prototypes
ALPHA_PROTOTYPE_NODE=node
ALPHA_PROTOTYPE_WORKER_DIR=./prototype-worker
ALPHA_PROTOTYPE_TEMPLATE_DIR=./prototype-template/zero-admin
# 沿用 Zero 的 PostgreSQL + currentSchema 配置；Alpha 使用独立 schema。
# URL 的 currentSchema 必须与 ALPHA_DATABASE_SCHEMA 一致。
ALPHA_DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=project_alpha_dev
ALPHA_DATABASE_SCHEMA=project_alpha_dev
ALPHA_DATABASE_USERNAME=postgres
ALPHA_DATABASE_PASSWORD=
